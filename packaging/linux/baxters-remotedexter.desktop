[Desktop Entry]
Type=Application
Name=RemoteDexter
GenericName=Remote Desktop Host
Comment=Share this desktop with a paired Android device
Exec=/opt/baxters/remotedexter/run.sh
Icon=baxters-remotedexter
Terminal=false
Categories=Network;RemoteAccess;
Keywords=remote;desktop;android;phone;wayland;
StartupNotify=true
StartupWMClass=baxters-remotedexter
