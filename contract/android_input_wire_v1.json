  "must_not_parse": [
    {
      "name": "mouse_move_missing_abs_fields",
      "event": {
        "MouseMove": {
          "mode": "Relative",
          "dx": 1,
          "dy": 1
        }
      },
      "why": "serde has no default for abs_x/abs_y; omitting them in Relative mode is rejected outright. This is the most likely real-world drift: they look ignorable."
    },
    {
      "name": "unit_variant_written_as_an_object",
      "event": {
        "FocusGained": {}
      },
      "why": "unit variants serialize as the bare string \"FocusGained\", not an empty object"
    },
    {
      "name": "unknown_button_action",
      "event": {
        "MouseButton": {
          "button": 0,
          "action": "Press"
        }
      },
      "why": "ButtonAction is exactly Up or Down"
    },
    {
      "name": "unknown_move_mode",
      "event": {
        "MouseMove": {
          "mode": "Trackpad",
          "dx": 1,
          "dy": 1,
          "abs_x": 0,
          "abs_y": 0
        }
      },
      "why": "MouseMoveMode is exactly Relative or Absolute"
    },
    {
      "name": "internally_tagged_shape",
      "event": {
        "type": "MouseButton",
        "button": 0,
        "action": "Down"
      },
      "why": "the enum is externally tagged; a type-field shape is a different encoding entirely"
    },
    {
      "name": "mouse_move_absolute_negative_coordinate",
      "why": "abs_x/abs_y are u32 host-side; a negative coordinate must be refused, never wrapped",
      "command": {
        "MouseMove": {
          "mode": "Absolute",
          "dx": 0,
          "dy": 0,
          "abs_x": -1,
          "abs_y": 5
        }
      }
    },
    {
      "name": "text_input_missing_text",
      "event": {
        "TextInput": {}
      },
      "why": "serde has no default for `text`; an empty object is not an empty string. Accepting it would turn a client bug into a silent no-op."
    },
    {
      "name": "text_input_wrong_type",
      "event": {
        "TextInput": {
          "text": 42
        }
      },
      "why": "`text` is a String. A number here means the client built the command wrongly, and coercing it would type something nobody asked for."
    },
    {
      "name": "key_event_lowercase_action",
      "event": {
        "KeyEvent": {
          "scan_code": 14,
          "action": "down",
          "modifiers": 0
        }
      },
      "why": "KeyAction serialises as `Down`/`Up`. Lower case is the drift a hand-written client produces, and accepting it would mean the two sides no longer agree on one spelling."
    }
  ]
}
