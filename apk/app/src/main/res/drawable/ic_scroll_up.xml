<!--
  Wheel-up. A chevron over a short stem: the stem says "a line moves", the
  chevron says which way. RemoteDexter's own line art on the same 24dp grid and
  2px stroke as the toolbar icons; no Material path data is copied.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?android:attr/textColorPrimary">
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M6,13 L12,7 L18,13" />
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M12,9 L12,18" />
</vector>
